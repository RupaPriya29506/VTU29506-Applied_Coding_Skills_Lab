import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[][] events = new int[n][2];
        for (int i = 0; i < n; i++) {
            events[i][0] = sc.nextInt();
            events[i][1] = sc.nextInt();
        }
        Arrays.sort(events, (a, b) ->
            Integer.compare(a[1], b[1]));
        int count = 0;
        int lastEnd = 0;
        for (int i = 0; i < n; i++) {
            if (events[i][0] >= lastEnd) {
                count++;
                lastEnd = events[i][1];
            }
        }
        System.out.println("MaximumEvents = " + count);
        sc.close();
    }
}


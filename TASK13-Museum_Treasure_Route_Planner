import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] dp = new int[n];
        for (int i = 0; i < n; i++) {
            int treasure = sc.nextInt();
            if (i == 0) {
                dp[i] = treasure;
            } else if (i == 1) {
                dp[i] = Math.max(dp[i - 1], treasure);
            } else {
                dp[i] = Math.max(dp[i - 1],
                                 dp[i - 2] + treasure);
            }
        }
        System.out.println(dp[n - 1]);
        sc.close();
    }
}


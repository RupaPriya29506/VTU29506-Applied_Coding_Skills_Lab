import java.util.*;
public class Main {
    static ArrayList<Integer>[] adj;
    static boolean[] visited;
    static void dfs(int node) {
        visited[node] = true;
        for (int next : adj[node]) {
            if (!visited[next]) {
                dfs(next);
            }
        }
    }
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int N = sc.nextInt();
        int M = sc.nextInt();
        adj = new ArrayList[N + 1];
        visited = new boolean[N + 1];
        for (int i = 1; i <= N; i++) {
            adj[i] = new ArrayList<>();
        }
        for (int i = 0; i < M; i++) {
            int u = sc.nextInt();
            int v = sc.nextInt();
            adj[u].add(v);
            adj[v].add(u);
        }
        int components = 0;
        for (int i = 1; i <= N; i++) {
            if (!visited[i]) {
                components++;
                dfs(i);
            }
        }
        System.out.println("Connected Components = " + components);
        sc.close();
    }
}

